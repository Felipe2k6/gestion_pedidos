  usecase "Iniciar sesion" as Login
  usecase "Cerrar sesion" as Logout
  usecase "Acceder a las funciones\npermitidas por rol" as RoleAccess
}

Administrador --> Login
Cliente --> Login
Proveedor --> Login

Administrador --> Logout
Cliente --> Logout
Proveedor --> Logout

Login --> RoleAccess : <<include>>
